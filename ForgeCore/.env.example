# Host-Verzeichnis, das für Downloads schreibbar als /media eingebunden wird.
# ZimaOS: bitte tatsächlichen Pfad der Medienfreigabe verwenden.
FORGECORE_MEDIA_HOST_PATH=./media
# Der Benutzer muss die Schreibfreigabe vor Installation ausdrücklich prüfen.

# Standard: Zugriff nur auf dem ZimaOS-Host. Nicht ohne abgesicherten Reverse-Proxy exponieren.
FORGECORE_BIND_ADDRESS=127.0.0.1
FORGECORE_SECURE_COOKIE=0

# Zeitzone der geplanten Download-Zeitfenster im Container
FORGECORE_TIMEZONE=Europe/Vienna

# Optional: TMDB API Read Access Token aus deinem TMDB-Account für Discover.
# Nie in Git einchecken. Ohne Token wird Discover als unkonfiguriert angezeigt.
FORGECORE_TMDB_TOKEN=
